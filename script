--------------------------------------------------------------------------
-- Read already-redeemed codes
-- DataFolder.Information.Codes = '{"HAPPYHOLIDAYS25":true,"XMAS2025":true,...}'
--------------------------------------------------------------------------
local function getRedeemed()
    local set = {}
    local dataFolder = localPlayer:WaitForChild("DataFolder", 30)
    local info = dataFolder and dataFolder:WaitForChild("Information", 30)
    local codesObj = info and info:WaitForChild("Codes", 30)
    if not codesObj then return set, false end

    if codesObj:IsA("ValueBase") then
        local raw = codesObj.Value
        if typeof(raw) ~= "string" or raw == "" then return set, true end
        local decoded, data = pcall(HttpService.JSONDecode, HttpService, raw)
        if not decoded or type(data) ~= "table" then return set, false end
        for k, v in pairs(data) do
            if type(k) == "string" and v then
                set[k:lower()] = true
            elseif type(v) == "string" then
                set[v:lower()] = true
            end
        end
    else
        for _, child in ipairs(codesObj:GetChildren()) do
            set[child.Name:lower()] = true
        end
    end
    return set, true
end

local redeemed, readOk = getRedeemed()
if not readOk then
    log("Couldn't read redeemed codes", "Will try every code instead.", "warning", 6)
end

local pending = {}
for _, code in ipairs(codes.codes) do
    if not redeemed[code:lower()] then
        table.insert(pending, code)
    end
end

local skipped = #codes.codes - #pending
dprint(`Already redeemed: {skipped} | To redeem: {#pending}`)

if #pending == 0 then
    log("Nothing to redeem", `You've already redeemed all {#codes.codes} codes.`, "success", 6)
    _env.__DH_REDEEMER_LOADED = false
    return
end

Notify("Starting", `Redeeming {#pending} new code(s), skipping {skipped} already redeemed.`, "info", 5)

--------------------------------------------------------------------------
-- Redeem
--------------------------------------------------------------------------
for index, code in ipairs(pending) do
    mainevent:FireServer("EnterPromoCode", code)
    dprint(`Redeemed Code [{index}/{#pending}]: {code}`)
    Notify(`Code {index}/{#pending}`, code, "info", 2.5)
    if index < #pending then
        task.wait(codes.rate or 1)
    end
end

-- Re-check to see which ones actually went through
task.wait(2)
local after = getRedeemed()
local confirmed, failed = 0, {}
for _, code in ipairs(pending) do
    if after[code:lower()] then
        confirmed += 1
    else
        table.insert(failed, code)
    end
end

if #failed == 0 then
    log("Done!", `Redeemed {confirmed} new code(s).`, "success", 6)
else
    log("Finished", `{confirmed} redeemed, {#failed} didn't go through.`, "warning", 7)
    dprint("Not confirmed: " .. table.concat(failed, ", "))
end

_env.__DH_REDEEMER_LOADED = false