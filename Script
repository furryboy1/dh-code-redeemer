-- Re-check to see which ones actually went through
--task.wait(2)
local after = getRedeemed(0)
local confirmed, failed = 0, {}
for _, code in ipairs(pending) do
    if after[code] then
        confirmed += 1
    else
        table.insert(failed, code)
    end
end

