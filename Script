-- Read already-redeemed codes
-- DataFolder.Information.Codes = '{"HAPPYHOLIDAYS25":true,"XMAS2025":true,...}'
--------------------------------------------------------------------------
local function getCodesObject()
    local dataFolder = localPlayer:WaitForChild("DataFolder", 30)
    local info = dataFolder and dataFolder:WaitForChild("Information", 30)
    return info and info:WaitForChild("Codes", 30)
end

-- Parses the current value. Returns (set, count) or nil if not loaded / not valid JSON yet.
local function parseCodes(codesObj)
    local set, count = {}, 0
    if codesObj:IsA("ValueBase") then
        local raw = codesObj.Value
        if typeof(raw) ~= "string" or raw == "" then return nil end
        local decoded, data = pcall(HttpService.JSONDecode, HttpService, raw)
        if not decoded or type(data) ~= "table" then return nil end
        for k, v in pairs(data) do
            if type(k) == "string" and v then
                set[k] = true
                count += 1
            elseif type(v) == "string" then
                set[v] = true
                count += 1
            end
        end
    else
        for _, child in ipairs(codesObj:GetChildren()) do
            set[child.Name] = true
            count += 1
        end
    end
    return set, count
end

-- Waits until the Codes value has actually loaded (non-empty, valid JSON with entries).
-- Gives up after `timeout` seconds and returns whatever it has (may be empty for new players).
local function getRedeemed(timeout)
    local codesObj = getCodesObject()
    if not codesObj then return {}, false end

    local deadline = os.clock() + (timeout or 0)
    local lastSet
    repeat
        local set, count = parseCodes(codesObj)
        if set then
            lastSet = set
            if count > 0 then return set, true end
        end
        if os.clock() >= deadline then break end
        task.wait() -- 0.25
    until false

    return lastSet or {}, lastSet ~= nil
end

