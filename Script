    log("Done!", `Redeemed {confirmed} new code(s).`, "success", 7)
else
    log("Finished", `{confirmed} redeemed, {#failed} didn't go through.`, "warning", 7)
    Debug.Output("Not confirmed: " .. table.concat(failed, ", "))
end

