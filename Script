--------------------------------------------------------------------------
-- Version check
-- The loadstring always pulls the latest script, so a mismatch means
-- someone pasted an old copy of the source instead of using the loadstring.
--------------------------------------------------------------------------
local function parseVersion(v)
    local parts = {}
    for n in tostring(v):gmatch("%d+") do table.insert(parts, tonumber(n)) end
    return parts
end

local function isOlder(a, b) -- true if version a < version b
    local pa, pb = parseVersion(a), parseVersion(b)
    for i = 1, math.max(#pa, #pb) do
        local x, y = pa[i] or 0, pb[i] or 0
        if x ~= y then return x < y end
    end
    return false
end

do
    local fetched, remote = pcall(game.HttpGet, game, REPO .. "Version")
    remote = fetched and remote and remote:match("^%s*(.-)%s*$")

    if not remote or remote == "" or remote:find("404") then
        Debug.Output("Version check failed, continuing anyway.")
    elseif isOlder(VERSION, remote) then
        log("Outdated version", `You're on v{VERSION}, latest is v{remote}. Use the loadstring instead of the source!`, "warning", 10)
        Debug.Output("Loadstring: " .. LOADSTRING)
        if setclipboard then
            pcall(function()
                setclipboard(LOADSTRING)
                Notify("Loadstring copied", "The up-to-date loadstring is on your clipboard.", "info", 8)
            end)
        end
    else
        Debug.Output(`Version v{VERSION} (up to date)`)
    end
end

