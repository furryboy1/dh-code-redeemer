local Notify
do
    local COLORS = {
        info    = Color3.fromRGB(88, 140, 255),
        success = Color3.fromRGB(70, 200, 120),
        warning = Color3.fromRGB(255, 180, 60),
        error   = Color3.fromRGB(240, 80, 80),
        rainbow = Color3.new(1, 1, 1), -- white base so the gradient shows its true colors
    }

    -- Rainbow: a hue-shifted ColorSequence rebuilt every frame so it scrolls seamlessly
    local RAINBOW_SPEED = 0.35 -- full cycles per second
    local RAINBOW_STEPS = 6
    local function rainbowSequence(shift)
        local points = {}
        for i = 0, RAINBOW_STEPS do
            local t = i / RAINBOW_STEPS
            points[i + 1] = ColorSequenceKeypoint.new(t, Color3.fromHSV((t + shift) % 1, 0.75, 1))
        end
        return ColorSequence.new(points)
    end

    local gui = Instance.new("ScreenGui")
    gui.Name = "DHR_Notifications"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 999
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    if syn and syn.protect_gui then pcall(syn.protect_gui, gui) end

    local parented = pcall(function()
        gui.Parent = (gethui and gethui()) or CoreGui
    end)
    if not parented then
        gui.Parent = localPlayer:WaitForChild("PlayerGui")
    end

    local holder = Instance.new("Frame")
    holder.Name = "Holder"
    holder.AnchorPoint = Vector2.new(1, 1)
    holder.Position = UDim2.new(1, -16, 1, -16)
    holder.Size = UDim2.new(0, 300, 1, -32)
    holder.BackgroundTransparency = 1
    holder.Parent = gui

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
    layout.Padding = UDim.new(0, 8)
    layout.Parent = holder

    local SLOT_HEIGHT = 64
    local order = 0

    local function new(class, props)
        local inst = Instance.new(class)
        for k, v in pairs(props) do inst[k] = v end
        return inst
    end

    function Notify(title, text, kind, duration)
        kind = COLORS[kind] and kind or "info"
        duration = duration or 4
        local accent = COLORS[kind]
        order += 1

        -- slot reserves space in the list so the card can slide independently
        local slot = new("Frame", {
            Name = "Notification",
            Size = UDim2.new(1, 0, 0, SLOT_HEIGHT),
            BackgroundTransparency = 1,
            LayoutOrder = order,
            Parent = holder,
        })

        local card = new("TextButton", {
            Text = "",
            AutoButtonColor = false,
            Size = UDim2.new(1, 0, 1, 0),
            Position = UDim2.new(1, 24, 0, 0),
            BackgroundColor3 = Color3.fromRGB(22, 22, 26),
            BorderSizePixel = 0,
            ClipsDescendants = true,
            Parent = slot,
        })
        new("UICorner", { CornerRadius = UDim.new(0, 8), Parent = card })
        local stroke = new("UIStroke", { Color = Color3.fromRGB(48, 48, 56), Thickness = 1, Parent = card })

        local side = new("Frame", {
            Size = UDim2.new(0, 3, 1, 0),
            BackgroundColor3 = accent,
            BorderSizePixel = 0,
            Parent = card,
        })

        local titleLabel = new("TextLabel", {
            Text = title,
            Font = Enum.Font.GothamBold,
            TextSize = 14,
            TextColor3 = Color3.fromRGB(245, 245, 250),
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            BackgroundTransparency = 1,
            RichText = true,
            Position = UDim2.new(0, 14, 0, 8),
            Size = UDim2.new(1, -24, 0, 18),
            Parent = card,
        })

        new("TextLabel", {
            Text = text or "",
            Font = Enum.Font.Gotham,
            TextSize = 13,
            TextColor3 = Color3.fromRGB(190, 190, 200),
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            TextWrapped = true,
            RichText = true,
            TextTruncate = Enum.TextTruncate.AtEnd,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 14, 0, 28),
            Size = UDim2.new(1, -24, 0, 30),
            Parent = card,
        })

        local bar = new("Frame", {
            AnchorPoint = Vector2.new(0, 1),
            Position = UDim2.new(0, 0, 1, 0),
            Size = UDim2.new(1, 0, 0, 2),
            BackgroundColor3 = accent,
            BorderSizePixel = 0,
            Parent = card,
        })

        local rainbowConn
        if kind == "rainbow" then
            stroke.Color = Color3.new(1, 1, 1)
            stroke.Thickness = 1.5
            local gradients = {
                new("UIGradient", { Parent = stroke }),
                new("UIGradient", { Parent = side, Rotation = 90 }),
                new("UIGradient", { Parent = titleLabel }),
                new("UIGradient", { Parent = bar }),
            }
            local start = os.clock()
            rainbowConn = RunService.Heartbeat:Connect(function()
                local seq = rainbowSequence((os.clock() - start) * RAINBOW_SPEED)
                for _, g in ipairs(gradients) do g.Color = seq end
            end)
            slot.Destroying:Connect(function() rainbowConn:Disconnect() end)
        end

        local closed = false
        local function close()
            if closed then return end
            closed = true
            local out = TweenService:Create(card, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                { Position = UDim2.new(1, 24, 0, 0) })
            out:Play()
            out.Completed:Wait()
            local shrink = TweenService:Create(slot, TweenInfo.new(0.2, Enum.EasingStyle.Quad),
                { Size = UDim2.new(1, 0, 0, 0) })
            shrink:Play()
            shrink.Completed:Wait()
            slot:Destroy()
        end

        card.MouseButton1Click:Connect(function() task.spawn(close) end)

        TweenService:Create(card, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
            { Position = UDim2.new(0, 0, 0, 0) }):Play()
        TweenService:Create(bar, TweenInfo.new(duration, Enum.EasingStyle.Linear),
            { Size = UDim2.new(0, 0, 0, 2) }):Play()

        task.delay(duration, close)
    end
end

